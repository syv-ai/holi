{
  "name": "@holi/desktop",
  "version": "0.8.0",
  "description": "Local-first markdown vaults on GitHub, with Claude Code as the assistant",
  "author": "syv.ai",
  "homepage": "https://github.com/syv-ai/holi",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-posix-lease.mjs && vite build --config vite.mdx-compiler.config.ts && electron-vite dev",
    "dev:debug": "node scripts/build-posix-lease.mjs && vite build --config vite.mdx-compiler.config.ts && electron-vite dev -- --remote-debugging-port=9333",
    "build": "node scripts/build-posix-lease.mjs && vite build --config vite.mdx-compiler.config.ts && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-posix-lease.mjs && vitest run",
    "rebuild:natives": "electron-rebuild -f -w node-pty",
    "shipped-history": "node scripts/shipped-history.mjs",
    "smoke:terminal-hints:native": "node scripts/run-terminal-hints-native-smoke.mjs",
    "smoke:browser-hints:native": "HOLI_524_HINTS=1 node scripts/run-browser-display-smoke.mjs",
    "smoke:terminal-hints:typecheck": "tsc --noEmit --project tsconfig.native-smoke.json",
    "smoke:pdf-vim:native": "node scripts/run-pdf-vim-native-smoke.mjs",
    "smoke:pdf-vim:typecheck": "tsc --noEmit --project tsconfig.pdf-vim-native-smoke.json",
    "smoke:mail-vim:native": "node scripts/run-mail-vim-native-smoke.mjs",
    "smoke:mail-vim:typecheck": "tsc --noEmit --project tsconfig.mail-vim-native-smoke.json",
    "smoke:rich-text-vim:native": "node scripts/run-rich-text-vim-native-smoke.mjs",
    "smoke:rich-text-vim:typecheck": "tsc --noEmit --project tsconfig.rich-text-vim-native-smoke.json",
    "smoke:files-subscriptions:native": "node scripts/run-files-subscriptions-smoke.mjs",
    "smoke:files-subscriptions:typecheck": "tsc --noEmit --project tsconfig.files-subscriptions-native-smoke.json",
    "smoke:mdx-diagnostics:native": "node scripts/run-mdx-diagnostics-native-smoke.mjs",
    "smoke:mdx-diagnostics:typecheck": "tsc --noEmit --project tsconfig.mdx-diagnostics-native-smoke.json",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "lint": "eslint --max-warnings 0 \"src/renderer/src/**/*.{ts,tsx}\" \"src/plugins/**/*.{ts,tsx}\"",
    "smoke:community-hints:native": "node scripts/run-community-hints-native-smoke.mjs",
    "smoke:github-storage:native": "node scripts/run-github-storage-native-smoke.mjs",
    "smoke:github-storage:typecheck": "tsc --noEmit --project tsconfig.github-storage-native-smoke.json",
    "smoke:community-hints:typecheck": "tsc --noEmit --project tsconfig.native-smoke.json",
    "smoke:browser-frame-addressing:native": "node scripts/run-browser-frame-addressing-smoke.mjs",
    "smoke:browser-frame-addressing:typecheck": "tsc --noEmit --project tsconfig.browser-frame-addressing-smoke.json"
  },
