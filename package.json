{
  "name": "holi",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @holi/desktop dev",
    "dev:debug": "pnpm --filter @holi/desktop dev:debug",
    "ui:add": "node scripts/ui-add.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @holi/desktop lint",
    "knip": "knip",
    "knip:production": "knip --production",
    "rulecast": "rulecast run --all-files",
    "rulecast:install": "rulecast install",
    "check:commit-msg": "node scripts/check-commit-msg.mjs",
    "format": "prettier --write .",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "lint-staged": {
    "apps/desktop/src/{renderer/src,plugins}/**/*.{ts,tsx}": "pnpm --filter @holi/desktop exec eslint --max-warnings 0",
    "*.{ts,tsx,js,mjs,cjs,json,jsonc,md,css,yml,yaml}": "prettier --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "patchedDependencies": {
      "codemirror-markdown-tables@1.0.0": "patches/codemirror-markdown-tables@1.0.0.patch"
    }
  },
  "devDependencies": {
    "@syv-ai/rulecast": "0.6.0",
    "@types/node": "^26.1.1",
    "knip": "6.43.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
