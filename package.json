{
  "name": "holi",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @holi/desktop dev",
    "dev:debug": "pnpm --filter @holi/desktop dev:debug",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @holi/desktop exec eslint \"src/renderer/src/**/*.{ts,tsx}\"",
    "lint:gate": "GATE_LEVEL=error pnpm --filter @holi/desktop exec eslint \"src/renderer/src/**/*.{ts,tsx}\"",
    "format": "prettier --write ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "apps/desktop/src/renderer/src/**/*.{ts,tsx}": "pnpm --filter @holi/desktop exec eslint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  }
}
